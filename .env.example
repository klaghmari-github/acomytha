# Développement Stripe uniquement : ne jamais committer les vraies valeurs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ACOMYTHA_PUBLIC_URL=http://127.0.0.1:8787

# Comptes de démonstration optionnels. Utiliser des secrets locaux non committés.
ACOMYTHA_ADMIN_EMAIL=
ACOMYTHA_ADMIN_PASSWORD=
ACOMYTHA_PARENT_EMAIL=
ACOMYTHA_PARENT_PASSWORD=

# Validation e-mail. Sans hôte SMTP, le lien est écrit dans les logs de développement.
ACOMYTHA_SMTP_HOST=
ACOMYTHA_SMTP_PORT=587
ACOMYTHA_SMTP_USER=
ACOMYTHA_SMTP_PASSWORD=
ACOMYTHA_SMTP_FROM=AcoMytha <noreply@acomytha.local>
ACOMYTHA_EMAIL_VERIFICATION_HOURS=24
